Checks: >
  -*,
  bugprone-*,
  clang-diagnostic-*,
  clang-analyzer-*,
  misc-*,
  cppcoreguidelines-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-avoid-do-while

WarningsAsErrors: ''

HeaderFilterRegex: 'include/tengine/.*'

FormatStyle: file
